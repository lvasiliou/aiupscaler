<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the app icon (Fluent style) and writes gui\Assets\AppIcon.ico and AppIcon.png.
       Run from the repository root with: dotnet run (project tools\make-icon) -->
  <!-- See Program.cs for the exact command line. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
