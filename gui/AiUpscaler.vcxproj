<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Overridable because MIDL is not long-path aware: deep checkouts need a short packages path. -->
    <PackagesDir Condition="'$(PackagesDir)' == ''">$(MSBuildThisFileDirectory)packages\</PackagesDir>
    <CppWinRTPkg>$(PackagesDir)Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT</CppWinRTPkg>
    <WilPkg>$(PackagesDir)Microsoft.Windows.ImplementationLibrary.1.0.260126.7\build\native\Microsoft.Windows.ImplementationLibrary</WilPkg>
    <SdkBuildToolsPkg>$(PackagesDir)Microsoft.Windows.SDK.BuildTools.10.0.26100.4654\build\Microsoft.Windows.SDK.BuildTools</SdkBuildToolsPkg>
    <MsixPkg>$(PackagesDir)Microsoft.Windows.SDK.BuildTools.MSIX.1.7.261008100\build\Microsoft.Windows.SDK.BuildTools.MSIX</MsixPkg>
    <WebView2Pkg>$(PackagesDir)Microsoft.Web.WebView2.1.0.3719.77\build\native\Microsoft.Web.WebView2</WebView2Pkg>
    <WasdkBasePkg>$(PackagesDir)Microsoft.WindowsAppSDK.Base.2.0.4\build\native\Microsoft.WindowsAppSDK.Base</WasdkBasePkg>
    <WasdkFoundationPkg>$(PackagesDir)Microsoft.WindowsAppSDK.Foundation.2.3.12\build\native\Microsoft.WindowsAppSDK.Foundation</WasdkFoundationPkg>
    <WasdkIxpPkg>$(PackagesDir)Microsoft.WindowsAppSDK.InteractiveExperiences.2.1.9\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences</WasdkIxpPkg>
    <WasdkDWritePkg>$(PackagesDir)Microsoft.WindowsAppSDK.DWrite.2.1.0\build\Microsoft.WindowsAppSDK.DWrite</WasdkDWritePkg>
    <WasdkWinUIPkg>$(PackagesDir)Microsoft.WindowsAppSDK.WinUI.2.3.9\build\native\Microsoft.WindowsAppSDK.WinUI</WasdkWinUIPkg>
    <WasdkRuntimePkg>$(PackagesDir)Microsoft.WindowsAppSDK.Runtime.2.5.1\build\native\Microsoft.WindowsAppSDK.Runtime</WasdkRuntimePkg>
  </PropertyGroup>

  <Import Project="$(CppWinRTPkg).props" Condition="Exists('$(CppWinRTPkg).props')" />
  <Import Project="$(SdkBuildToolsPkg).props" Condition="Exists('$(SdkBuildToolsPkg).props')" />
  <Import Project="$(MsixPkg).props" Condition="Exists('$(MsixPkg).props')" />
  <Import Project="$(WasdkBasePkg).props" Condition="Exists('$(WasdkBasePkg).props')" />
  <Import Project="$(WasdkFoundationPkg).props" Condition="Exists('$(WasdkFoundationPkg).props')" />
  <Import Project="$(WasdkIxpPkg).props" Condition="Exists('$(WasdkIxpPkg).props')" />
  <Import Project="$(WasdkDWritePkg).props" Condition="Exists('$(WasdkDWritePkg).props')" />
  <Import Project="$(WasdkWinUIPkg).props" Condition="Exists('$(WasdkWinUIPkg).props')" />
  <Import Project="$(WasdkRuntimePkg).props" Condition="Exists('$(WasdkRuntimePkg).props')" />

  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{6B1E8F2A-4C3D-4E5F-9A7B-1C2D3E4F5A6B}</ProjectGuid>
    <ProjectName>AiUpscaler</ProjectName>
    <RootNamespace>AiUpscaler</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <AppContainerApplication>false</AppContainerApplication>
    <AppxPackage>false</AppxPackage>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged + self-contained: a plain .exe, no MSIX install or runtime installer needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- .NET-only WinMD de-duplication step; its task fails to load under MSBuild 18 and C++ does not need it. -->
    <AppxWindowsMetadataReferenceSupportEnabled>false</AppxWindowsMetadataReferenceSupportEnabled>
    <!-- Folder holding the Rust build output (ai-upscaler.exe + DirectML.dll). -->
    <EngineDir Condition="'$(EngineDir)' == ''">$(MSBuildThisFileDirectory)..\upscaler\target\release</EngineDir>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <DesktopCompatible>true</DesktopCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="AiUpscaler.rc" />
    <!-- The title bar shows the icon as an image; the .ico itself is compiled into the .exe. -->
    <None Include="Assets\AppIcon.ico" />
    <None Include="Assets\AppIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="MainWindow.idl">
      <SubType>Code</SubType>
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Midl>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="MainWindow.xaml.h">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="EngineJob.h" />
    <ClInclude Include="Settings.h" />
    <ClInclude Include="ToolLocator.h" />
    <ClInclude Include="ModelLibrary.h" />
    <ClInclude Include="Strings.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainWindow.xaml.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="EngineJob.cpp" />
    <ClCompile Include="Settings.cpp" />
    <ClCompile Include="ToolLocator.cpp" />
    <ClCompile Include="ModelLibrary.cpp" />
    <ClCompile Include="Strings.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <!-- UI text per language (MRT Core). Add a language by adding Strings\<tag>\Resources.resw. -->
  <ItemGroup>
    <PRIResource Include="Strings\en-US\Resources.resw" />
    <PRIResource Include="Strings\el-GR\Resources.resw" />
    <PRIResource Include="Strings\de-DE\Resources.resw" />
    <PRIResource Include="Strings\fr-FR\Resources.resw" />
    <PRIResource Include="Strings\zh-CN\Resources.resw" />
    <PRIResource Include="Strings\tr-TR\Resources.resw" />
    <PRIResource Include="Strings\ja-JP\Resources.resw" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Import Project="$(CppWinRTPkg).targets" Condition="Exists('$(CppWinRTPkg).targets')" />
  <Import Project="$(WilPkg).targets" Condition="Exists('$(WilPkg).targets')" />
  <Import Project="$(SdkBuildToolsPkg).targets" Condition="Exists('$(SdkBuildToolsPkg).targets')" />
  <Import Project="$(MsixPkg).targets" Condition="Exists('$(MsixPkg).targets')" />
  <Import Project="$(WebView2Pkg).targets" Condition="Exists('$(WebView2Pkg).targets')" />
  <Import Project="$(WasdkBasePkg).targets" Condition="Exists('$(WasdkBasePkg).targets')" />
  <Import Project="$(WasdkFoundationPkg).targets" Condition="Exists('$(WasdkFoundationPkg).targets')" />
  <Import Project="$(WasdkIxpPkg).targets" Condition="Exists('$(WasdkIxpPkg).targets')" />
  <Import Project="$(WasdkDWritePkg).targets" Condition="Exists('$(WasdkDWritePkg).targets')" />
  <Import Project="$(WasdkWinUIPkg).targets" Condition="Exists('$(WasdkWinUIPkg).targets')" />
  <Import Project="$(WasdkRuntimePkg).targets" Condition="Exists('$(WasdkRuntimePkg).targets')" />

  <Target Name="EnsurePackages" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CppWinRTPkg).props') Or !Exists('$(WasdkWinUIPkg).targets')" Text="NuGet packages are missing. Run restore-packages.ps1 first." />
  </Target>

  <!-- Ship the Rust engine in an engine\ subfolder so its DLLs never clash with the app's. -->
  <Target Name="CopyEngine" AfterTargets="Build">
    <ItemGroup>
      <EngineFiles Include="$(EngineDir)\ai-upscaler.exe;$(EngineDir)\*.dll" />
    </ItemGroup>
    <Warning Condition="!Exists('$(EngineDir)\ai-upscaler.exe')" Text="Rust engine not found in $(EngineDir). Run `cargo build --release` in ..\upscaler or pass -p:EngineDir=..." />
    <Copy SourceFiles="@(EngineFiles)" DestinationFolder="$(OutDir)engine" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Assets\AppIcon.png" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
